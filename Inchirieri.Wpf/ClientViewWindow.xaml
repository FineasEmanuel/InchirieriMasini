<Window x:Class="Inchirieri.Wpf.ClientViewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Vizualizare Mașini" Height="450" Width="800" WindowStartupLocation="CenterScreen">
    <Grid Margin="8">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource PanelBrush}" Padding="8" CornerRadius="6">
            <StackPanel>
            <TextBlock Text="Mașini" FontWeight="Bold" />
            <TextBox x:Name="TxtCautareClient" Margin="0,6,0,6" KeyDown="TxtCautareClient_KeyDown" />
            <Button Content="Caută" Click="BtnSearchClient_Click" Width="80" />
            <ListBox x:Name="LstMasiniClient" Margin="0,6,0,0" DisplayMemberPath="Marca" SelectionChanged="LstMasiniClient_SelectionChanged" />
            <Button x:Name="BtnReserve" Content="Rezervă" Click="BtnReserve_Click" Margin="0,6,0,0" Width="100" IsEnabled="False" Style="{StaticResource ReserveButtonStyle}" />
            <Separator Margin="0,8,0,8" />
            <TextBlock Text="Clienți" FontWeight="Bold" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <TextBox x:Name="TxtClientSearch" Width="140" />
                <Button Content="Caută client" Click="BtnSearchClientEntity_Click" Margin="6,0,0,0" />
            </StackPanel>
            <ListBox x:Name="LstClienti" Margin="0,6,0,0" DisplayMemberPath="Nume" SelectionChanged="LstClienti_SelectionChanged" />
            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                <Button x:Name="BtnAddClient" Content="Adaugă client" Click="BtnAddClient_Click" Style="{StaticResource AddButtonStyle}" />
                <Button x:Name="BtnUpdateClient" Content="Actualizează client" Click="BtnUpdateClient_Click" Margin="6,0,0,0" Style="{StaticResource UpdateButtonStyle}" />
                <Button x:Name="BtnDeleteClient" Content="Șterge client" Click="BtnDeleteClient_Click" Margin="6,0,0,0" Style="{StaticResource DeleteButtonStyle}" />
            </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Margin="8" Padding="8" BorderBrush="{StaticResource TurquoiseDark}" BorderThickness="1" Background="{StaticResource PanelBrush}">
            <ScrollViewer>
                <StackPanel>
                    <Image x:Name="ImgClientDetalii" Height="200" Stretch="Uniform" Margin="0,0,0,8" />
                    <TextBlock x:Name="TxtDetaliiClient" Text="Selectează o mașină..." TextWrapping="Wrap" />
                    <Separator Margin="0,12,0,12" />
                    <TextBlock Text="Editor Client" FontWeight="Bold" />
                    <StackPanel Orientation="Vertical" Margin="0,6,0,0">
                        <TextBlock Text="Nume" />
                        <TextBox x:Name="EdNume" Text="{Binding SelectedItem.Nume, ElementName=LstClienti, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Prenume" Margin="0,6,0,0" />
                        <TextBox x:Name="EdPrenume" Text="{Binding SelectedItem.Prenume, ElementName=LstClienti, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="CNP" Margin="0,6,0,0" />
                        <TextBox x:Name="EdCNP" Text="{Binding SelectedItem.CNP, ElementName=LstClienti, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
