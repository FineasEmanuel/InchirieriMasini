<Window x:Class="Inchirieri.Wpf.ReservationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoRent Desk - Rezervare"
        Height="520"
        Width="560"
        MinHeight="480"
        MinWidth="520"
        WindowStartupLocation="CenterOwner">
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="{StaticResource HeaderBrush}"
                Padding="20,14">
            <StackPanel>
                <TextBlock Text="Rezervare masina"
                           Foreground="White"
                           FontSize="24"
                           FontWeight="Bold" />
                <TextBlock x:Name="TxtMasina"
                           Foreground="#E8EDFF" />
            </StackPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Border Margin="18" Style="{StaticResource PanelBorderStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Nume" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="TxtNume" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Prenume" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="TxtPrenume" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="CNP" Style="{StaticResource FieldLabelStyle}" />
                    <TextBox x:Name="TxtCNP" MaxLength="13" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Telefon" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="TxtTelefon" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Email" Style="{StaticResource FieldLabelStyle}" />
                            <TextBox x:Name="TxtEmail" />
                        </StackPanel>
                    </Grid>

                    <TextBlock Text="Perioada" Style="{StaticResource FieldLabelStyle}" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <DatePicker x:Name="StartDate" />
                        <DatePicker x:Name="EndDate" Grid.Column="2" />
                    </Grid>

                    <Border Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,14,0,0">
                        <TextBlock x:Name="TxtPretTotal"
                                   Text="Alege perioada pentru calcul."
                                   FontWeight="Bold" />
                    </Border>

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,18,0,0">
                        <Button x:Name="BtnConfirm"
                                Content="Confirma rezervare"
                                Width="150"
                                Click="BtnConfirm_Click"
                                Style="{StaticResource ReserveButtonStyle}" />
                        <Button Content="Anuleaza"
                                Width="90"
                                Margin="8,0,0,0"
                                Click="BtnCancel_Click" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </DockPanel>
</Window>
