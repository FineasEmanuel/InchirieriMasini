<Window x:Class="Inchirieri.Wpf.ReservationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rezervare mașină" Height="400" Width="500" WindowStartupLocation="CenterOwner">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Text="Rezervare mașină" FontSize="18" FontWeight="Bold" />

        <StackPanel Grid.Row="1" Margin="0,12,0,0">
            <TextBlock Text="Mașina:" FontWeight="Bold" />
            <TextBlock x:Name="TxtMasina" />

            <TextBlock Text="Nume" Margin="0,8,0,0" />
            <TextBox x:Name="TxtNume" />

            <TextBlock Text="Prenume" Margin="0,8,0,0" />
            <TextBox x:Name="TxtPrenume" />

            <TextBlock Text="CNP" Margin="0,8,0,0" />
            <TextBox x:Name="TxtCNP" />

            <TextBlock Text="Telefon" Margin="0,8,0,0" />
            <TextBox x:Name="TxtTelefon" />

            <TextBlock Text="Email" Margin="0,8,0,0" />
            <TextBox x:Name="TxtEmail" />

            <TextBlock Text="Perioadă" Margin="0,8,0,0" FontWeight="Bold" />
            <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                <DatePicker x:Name="StartDate" Width="150" />
                <DatePicker x:Name="EndDate" Width="150" Margin="8,0,0,0" />
            </StackPanel>

            <TextBlock x:Name="TxtPretTotal" Margin="0,8,0,0" FontWeight="Bold" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="BtnConfirm" Content="Confirmă rezervare" Width="140" Click="BtnConfirm_Click" />
                <Button Content="Anulează" Width="80" Margin="8,0,0,0" Click="BtnCancel_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
    </ScrollViewer>
</Window>
