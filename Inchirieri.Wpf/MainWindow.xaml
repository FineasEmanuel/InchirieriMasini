<Window x:Class="Inchirieri.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoRent Desk - Administrare"
        Height="720"
        Width="1120"
        MinHeight="660"
        MinWidth="980"
        WindowStartupLocation="CenterScreen">
    <DockPanel>
        <Border DockPanel.Dock="Top"
                Background="{StaticResource HeaderBrush}"
                Padding="24,18">
            <Grid>
                <StackPanel>
                    <TextBlock Text="AutoRent Desk"
                               Foreground="White"
                               FontSize="30"
                               FontWeight="Bold" />
                    <TextBlock Text="Administrare masini, clienti si rezervari"
                               Foreground="#E8EDFF"
                               FontSize="14"
                               Margin="0,4,0,0" />
                </StackPanel>
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="#2B367C"
                        CornerRadius="8"
                        Padding="14,9">
                    <StackPanel>
                        <TextBlock Text="Masini afisate"
                                   Foreground="#CAD3FF"
                                   FontSize="11"
                                   FontWeight="SemiBold" />
                        <TextBlock x:Name="TxtTotalMasini"
                                   Text="0"
                                   Foreground="White"
                                   FontSize="20"
                                   FontWeight="Bold" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Menu DockPanel.Dock="Top"
              Background="White"
              BorderBrush="{StaticResource LineBrush}"
              BorderThickness="0,0,0,1">
            <MenuItem Header="_File">
                <MenuItem Header="Exit" Click="MenuExit_Click" />
            </MenuItem>
            <MenuItem Header="_Actiuni">
                <MenuItem Header="Masina noua" Click="MenuMasinaNoua_Click" />
                <MenuItem Header="Rezerva masina selectata" Click="MenuRezerva_Click" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Refresh date" Click="MenuRefresh_Click" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Despre" Click="MenuDespre_Click" />
            </MenuItem>
        </Menu>

        <Grid Margin="18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.05*" MinWidth="260" />
                <ColumnDefinition Width="1.35*" MinWidth="330" />
                <ColumnDefinition Width="1.1*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource PanelBorderStyle}" Margin="0,0,14,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Catalog masini"
                               FontSize="20"
                               FontWeight="Bold" />

                    <TextBox x:Name="TxtCautareStanga"
                             Grid.Row="1"
                             Margin="0,14,0,8"
                             KeyDown="TxtCautareStanga_KeyDown" />

                    <WrapPanel Grid.Row="2" Margin="0,0,0,10">
                        <Button Content="Cauta"
                                Click="BtnSearchLeft_Click"
                                Style="{StaticResource PrimaryButtonStyle}"
                                Margin="0,0,8,8" />
                        <Button Content="Reset"
                                Click="BtnResetFilters_Click"
                                Margin="0,0,8,8" />
                    </WrapPanel>

                    <ListBox x:Name="MasiniList"
                             Grid.Row="3"
                             SelectionChanged="MasiniList_SelectionChanged">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border Padding="8"
                                        Margin="0,2"
                                        BorderBrush="#EDF1F7"
                                        BorderThickness="0,0,0,1">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Descriere}"
                                                   FontWeight="Bold"
                                                   FontSize="14" />
                                        <TextBlock Text="{Binding PretAfisare}"
                                                   Foreground="{StaticResource MutedBrush}" />
                                        <TextBlock Text="{Binding StatusDisponibilitate}"
                                                   Foreground="{StaticResource PrimaryBrush}"
                                                   FontWeight="SemiBold" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>

                    <StackPanel Grid.Row="4" Margin="0,12,0,0">
                        <TextBlock Text="Filtre rapide" Style="{StaticResource FieldLabelStyle}" />
                        <CheckBox x:Name="ChkFiltruDisponibile" Content="Doar disponibile" IsChecked="False" Checked="Filter_Changed" Unchecked="Filter_Changed" />
                        <CheckBox x:Name="ChkFiltruAutomata" Content="Cutie automata" Checked="Filter_Changed" Unchecked="Filter_Changed" />
                        <CheckBox x:Name="ChkFiltruAer" Content="Aer conditionat" Checked="Filter_Changed" Unchecked="Filter_Changed" />
                    </StackPanel>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Style="{StaticResource PanelBorderStyle}"
                    Margin="0,0,14,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="Preview inchiriere"
                               FontSize="20"
                               FontWeight="Bold" />

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  Margin="0,14,0,12">
                        <StackPanel>
                            <Border Height="190"
                                    Background="{StaticResource SurfaceAltBrush}"
                                    CornerRadius="8"
                                    Margin="0,0,0,12">
                                <Image x:Name="ImgDetalii"
                                       Stretch="Uniform"
                                       Margin="8" />
                            </Border>
                            <TextBlock x:Name="TxtDetalii"
                                       Text="Selecteaza o masina din catalog."
                                       FontSize="14"
                                       TextWrapping="Wrap" />
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2"
                            Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <StackPanel>
                            <TextBlock Text="Calculator pret" FontWeight="Bold" />
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <DatePicker x:Name="StartDatePicker" />
                                <DatePicker x:Name="EndDatePicker" Grid.Column="2" />
                            </Grid>
                            <WrapPanel Margin="0,10,0,0">
                                <Button Content="Calculeaza total"
                                        Click="BtnCalcTotal_Click"
                                        Style="{StaticResource UpdateButtonStyle}"
                                        Margin="0,0,8,8" />
                                <Button Content="Rezerva"
                                        Click="BtnOpenReservation_Click"
                                        Style="{StaticResource ReserveButtonStyle}"
                                        Margin="0,0,8,8" />
                            </WrapPanel>
                            <TextBlock x:Name="TxtCost"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryDarkBrush}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="2"
                    Style="{StaticResource PanelBorderStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Editor masina"
                                   FontSize="20"
                                   FontWeight="Bold" />

                        <TextBlock Text="Marca" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="TxtMarca" />

                        <TextBlock Text="Model" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="TxtModel" />

                        <TextBlock Text="Pret pe zi" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="TxtPret" />

                        <TextBlock Text="Imagine URL" Style="{StaticResource FieldLabelStyle}" />
                        <TextBox x:Name="TxtImageUrl" />

                        <CheckBox x:Name="ChkDisponibila"
                                  Content="Disponibila"
                                  Margin="0,10,0,0" />

                        <TextBlock Text="Culoare" Style="{StaticResource FieldLabelStyle}" />
                        <ComboBox x:Name="CuloareComboBox" />

                        <TextBlock Text="Optiuni" Style="{StaticResource FieldLabelStyle}" />
                        <WrapPanel>
                            <CheckBox x:Name="ChkAer" Content="Aer conditionat" />
                            <CheckBox x:Name="ChkNavigatie" Content="Navigatie" />
                            <CheckBox x:Name="ChkCutie" Content="Cutie automata" />
                            <CheckBox x:Name="ChkIluminare" Content="Iluminare ambientala" />
                            <CheckBox x:Name="Chk5Locuri" Content="5 locuri" />
                            <CheckBox x:Name="Chk7Locuri" Content="7 locuri" />
                        </WrapPanel>

                        <Border x:Name="EditorMessagePanel"
                                Margin="0,12,0,0"
                                Padding="10"
                                CornerRadius="8"
                                BorderThickness="1"
                                Visibility="Collapsed">
                            <TextBlock x:Name="EditorMessageText"
                                       TextWrapping="Wrap" />
                        </Border>

                        <UniformGrid Columns="3" Margin="0,14,0,0">
                            <Button x:Name="BtnAdd"
                                    Content="Adauga"
                                    Click="BtnAdd_Click"
                                    Style="{StaticResource AddButtonStyle}"
                                    Margin="0,0,6,0" />
                            <Button x:Name="BtnUpdate"
                                    Content="Actualizeaza"
                                    Click="BtnUpdate_Click"
                                    Style="{StaticResource UpdateButtonStyle}"
                                    Margin="0,0,6,0" />
                            <Button x:Name="BtnDelete"
                                    Content="Sterge"
                                    Click="BtnDelete_Click"
                                    Style="{StaticResource DeleteButtonStyle}" />
                        </UniformGrid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </DockPanel>
</Window>
