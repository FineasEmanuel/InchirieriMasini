<Application x:Class="Inchirieri.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="LoginWindow.xaml">
    <Application.Resources>
        <!-- Turquoise theme brushes -->
        <SolidColorBrush x:Key="TurquoiseLight" Color="#FFDEFBF5" />
        <SolidColorBrush x:Key="TurquoiseMedium" Color="#FF9EEFE6" />
        <SolidColorBrush x:Key="TurquoiseDark" Color="#FF2BB6A5" />
        <!-- Dark panel brush for better contrast on black background -->
        <SolidColorBrush x:Key="PanelBrush" Color="#FF072626" />
        <SolidColorBrush x:Key="ButtonBrush" Color="#FF57D3C2" />
        <SolidColorBrush x:Key="TextBoxBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="WindowBackground" Color="#FF000000" />

        <!-- Global styles -->
        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource WindowBackground}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="White" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource ButtonBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Padding" Value="6,4" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="BorderBrush" Value="{StaticResource TurquoiseDark}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <!-- Rounded button template used by function styles -->
        <ControlTemplate x:Key="RoundedButtonTemplate" TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="6"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
        </ControlTemplate>

        <!-- Function-specific button styles -->
        <Style x:Key="AddButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FF2ECC71" /> <!-- green -->
            <Setter Property="BorderBrush" Value="#FF27AE60" />
            <Setter Property="Template" Value="{StaticResource RoundedButtonTemplate}" />
        </Style>

        <Style x:Key="DeleteButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FFE74C3C" /> <!-- red -->
            <Setter Property="BorderBrush" Value="#FFC0392B" />
            <Setter Property="Template" Value="{StaticResource RoundedButtonTemplate}" />
        </Style>

        <Style x:Key="UpdateButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FFF1C40F" /> <!-- yellow -->
            <Setter Property="BorderBrush" Value="#FFD4AC0D" />
            <Setter Property="Foreground" Value="Black" />
            <Setter Property="Template" Value="{StaticResource RoundedButtonTemplate}" />
        </Style>

        <Style x:Key="ReserveButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#FF3498DB" /> <!-- blue -->
            <Setter Property="BorderBrush" Value="#FF2E86C1" />
            <Setter Property="Template" Value="{StaticResource RoundedButtonTemplate}" />
        </Style>
    </Application.Resources>
</Application>
